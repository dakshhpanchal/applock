diff --git a/app/src/main/java/dev/pranav/applock/features/faceauth/BlinkLivenessDetector.kt b/app/src/main/java/dev/pranav/applock/features/faceauth/BlinkLivenessDetector.kt
new file mode 100644
index 0000000..ca058c7
--- /dev/null
+++ b/app/src/main/java/dev/pranav/applock/features/faceauth/BlinkLivenessDetector.kt
@@ -0,0 +1,46 @@
+package dev.pranav.applock.features.faceauth
+
+/**
+ * Passes once it sees eyes open -> both eyes closed -> eyes open again, with the closed phase
+ * no longer than [maxClosedMs]. Defeats a still photo; does NOT defeat a replayed video.
+ *
+ * Pure Kotlin (takes eye-open probabilities, not ML Kit types) so it can be unit tested.
+ */
+class BlinkLivenessDetector(
+    private val openThreshold: Float = 0.6f,
+    private val closedThreshold: Float = 0.25f,
+    private val maxClosedMs: Long = 1_000,
+) {
+    private enum class State { WAIT_OPEN, OPEN, CLOSED, PASSED }
+
+    private var state = State.WAIT_OPEN
+    private var closedAt = 0L
+
+    val passed: Boolean get() = state == State.PASSED
+
+    /** Feed one frame's eye-open probabilities (null = unknown). Returns [passed]. */
+    fun update(leftOpen: Float?, rightOpen: Float?, nowMs: Long): Boolean {
+        if (state == State.PASSED) return true
+        if (leftOpen == null || rightOpen == null) return false
+
+        val bothOpen = leftOpen >= openThreshold && rightOpen >= openThreshold
+        val bothClosed = leftOpen <= closedThreshold && rightOpen <= closedThreshold
+
+        state = when (state) {
+            State.WAIT_OPEN -> if (bothOpen) State.OPEN else State.WAIT_OPEN
+            State.OPEN -> if (bothClosed) { closedAt = nowMs; State.CLOSED } else State.OPEN
+            State.CLOSED -> when {
+                nowMs - closedAt > maxClosedMs -> State.WAIT_OPEN // eyes shut too long, not a blink
+                bothOpen -> State.PASSED
+                else -> State.CLOSED
+            }
+            State.PASSED -> State.PASSED
+        }
+        return passed
+    }
+
+    fun reset() {
+        state = State.WAIT_OPEN
+        closedAt = 0L
+    }
+}
diff --git a/app/src/main/java/dev/pranav/applock/features/faceauth/FaceCameraAnalyzer.kt b/app/src/main/java/dev/pranav/applock/features/faceauth/FaceCameraAnalyzer.kt
new file mode 100644
index 0000000..13a5c5f
--- /dev/null
+++ b/app/src/main/java/dev/pranav/applock/features/faceauth/FaceCameraAnalyzer.kt
@@ -0,0 +1,45 @@
+package dev.pranav.applock.features.faceauth
+
+import android.graphics.Bitmap
+import android.graphics.Matrix
+import android.os.SystemClock
+import androidx.camera.core.ImageAnalysis
+import androidx.camera.core.ImageProxy
+
+/**
+ * CameraX analyzer that converts each frame to an upright bitmap, runs it through
+ * [processor] and hands the [FrameResult] to [onResult] (on the analyzer thread).
+ *
+ * Build the ImageAnalysis use case with:
+ *   .setOutputImageFormat(ImageAnalysis.OUTPUT_IMAGE_FORMAT_RGBA_8888)
+ *   .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
+ * and a single-thread executor (the embedder isn't thread-safe).
+ */
+class FaceCameraAnalyzer(
+    private val processor: FaceFrameProcessor,
+    private val onResult: (result: FrameResult, timestampMs: Long) -> Unit,
+) : ImageAnalysis.Analyzer {
+
+    override fun analyze(image: ImageProxy) {
+        val now = SystemClock.elapsedRealtime()
+        val upright = image.use { proxy ->
+            val raw = proxy.toBitmap()
+            val rotation = proxy.imageInfo.rotationDegrees
+            if (rotation == 0) raw
+            else Bitmap.createBitmap(
+                raw, 0, 0, raw.width, raw.height,
+                Matrix().apply { postRotate(rotation.toFloat()) }, true,
+            ).also { raw.recycle() }
+        }
+        try {
+            val result = try {
+                processor.process(upright)
+            } catch (e: Exception) {
+                FrameResult.Rejected(Hint.NO_FACE) // one bad frame shouldn't kill the stream
+            }
+            onResult(result, now)
+        } finally {
+            upright.recycle()
+        }
+    }
+}
