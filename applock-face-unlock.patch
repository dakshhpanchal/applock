diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 12c9f0f..6f657ed 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -46,6 +46,11 @@ android {
         aidl = true
     }
 
+    androidResources {
+        // The TFLite model is memory-mapped, so it must be stored uncompressed.
+        noCompress += "tflite"
+    }
+
     dependenciesInfo {
         includeInApk = false
         includeInBundle = false
@@ -74,6 +79,16 @@ dependencies {
     implementation(libs.hiddenapibypass)
     implementation(project(":patternlock"))
 
+    // Face unlock (camera + ML Kit detection + TFLite embedding)
+    implementation(libs.androidx.camera.core)
+    implementation(libs.androidx.camera.camera2)
+    implementation(libs.androidx.camera.lifecycle)
+    implementation(libs.androidx.camera.view)
+    implementation(libs.mlkit.face.detection)
+    implementation(libs.litert)
+
+    testImplementation(libs.junit)
+
 
 
     debugImplementation(libs.androidx.ui.tooling)
diff --git a/app/proguard-rules.pro b/app/proguard-rules.pro
index 481bb43..b33124d 100644
--- a/app/proguard-rules.pro
+++ b/app/proguard-rules.pro
@@ -18,4 +18,7 @@
 
 # If you keep the line number information, uncomment this to
 # hide the original source file name.
-#-renamesourcefileattribute SourceFile
\ No newline at end of file
+#-renamesourcefileattribute SourceFile
+# Face unlock: TFLite/LiteRT uses JNI and reflection
+-keep class org.tensorflow.lite.** { *; }
+-dontwarn org.tensorflow.lite.**
